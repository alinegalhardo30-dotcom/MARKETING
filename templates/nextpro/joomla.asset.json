{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "tpl_nextpro",
  "version": "1.0.0",
  "description": "Next Pro template assets",
  "license": "GPL-2.0-or-later",
  "assets": [
    {
      "name": "vendor.bootstrap.css",
      "type": "style",
      "uri": "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css",
      "version": "5.3.3"
    },
    {
      "name": "vendor.bootstrap.js",
      "type": "script",
      "uri": "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js",
      "version": "5.3.3",
      "attributes": { "defer": true }
    },
    {
      "name": "template.nextpro.css",
      "type": "style",
      "uri": "templates/nextpro/css/template.css",
      "version": "auto",
      "dependencies": ["vendor.bootstrap.css"]
    },
    {
      "name": "template.nextpro.custom.css",
      "type": "style",
      "uri": "templates/nextpro/css/custom.css",
      "version": "auto",
      "dependencies": ["template.nextpro.css"]
    },
    {
      "name": "template.nextpro.js",
      "type": "script",
      "uri": "templates/nextpro/js/template.js",
      "version": "auto",
      "dependencies": ["vendor.bootstrap.js"],
      "attributes": { "defer": true }
    },
    {
      "name": "template.nextpro",
      "type": "preset",
      "dependencies": [
        "template.nextpro.css",
        "template.nextpro.custom.css",
        "template.nextpro.js"
      ]
    }
  ]
}
